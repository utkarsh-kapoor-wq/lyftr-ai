# ==============================================================================
# Backend Local Environment Configuration
# Configured for: Utkarsh Kapoor (GitHub: utkarsh-kapoor-wq)
# ==============================================================================

# Comma-separated LLM provider API keys (minimum 2 keys required)
LLM_API_KEYS=your_first_gemini_key,your_second_gemini_key

# LiteLLM model identifier
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite storage URL
DATABASE_URL=sqlite:///./data/app.db

# Allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable failover test header hook X-Simulate-Failure
ENABLE_FAILURE_SIMULATION=true

# Optional global default system prompt
DEFAULT_SYSTEM_PROMPT=You are an expert AI software engineer pair programmer.
