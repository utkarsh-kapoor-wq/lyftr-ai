# ==============================================================================
# LiteLLM Multi-Turn Chat Environment Configuration
# Configured for: Utkarsh Kapoor (GitHub: utkarsh-kapoor-wq)
# ==============================================================================

# Comma-separated LLM provider API keys (minimum 2 keys required for failover pool)
# Keys are mapped sequentially to key_1, key_2, ...
LLM_API_KEYS=your_first_gemini_or_openai_key_here,your_second_gemini_or_openai_key_here

# Default LiteLLM model identifier (supports gemini/*, gpt-4o, claude-3-5-sonnet, etc.)
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite storage URL (parent directory auto-created if missing)
# In Docker compose: sqlite:////data/app.db
# In local development: sqlite:///./data/app.db
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated allowed CORS origins (or * for all)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable failover test header hook X-Simulate-Failure (true / false)
ENABLE_FAILURE_SIMULATION=true

# Optional global default system prompt (overridden per session if specified)
DEFAULT_SYSTEM_PROMPT=You are an expert AI software engineer pair programmer.

# Frontend API base URL (used during frontend build/runtime)
VITE_API_URL=http://localhost:8000
